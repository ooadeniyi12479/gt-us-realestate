# Database
DATABASE_URL=postgresql+psycopg://gtext:gtext_dev_password@db:5432/gtext
CORS_ORIGINS=http://localhost:8080

# Refresh/reconciliation
REFRESH_HOURS=6
STALE_HOURS=18

# Live US property feed - RentCast
# Obtain an API key from your RentCast account and never commit the real key.
RENTCAST_API_KEY=
RENTCAST_BASE_URL=https://api.rentcast.io/v1

# AI investment memos
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Investor email alerts (use your provider's SMTP values)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Future/optional provider adapters
ATTOM_API_KEY=
BATCHDATA_API_KEY=
RESO_BASE_URL=
RESO_CLIENT_ID=
RESO_CLIENT_SECRET=

# Investor authentication
AUTH_REQUIRED=true

# Licensed distressed/off-market seller feed.
# Expected endpoint: GET returning a JSON array or {"records": [...]} with normalized fields
# such as property_id, record_type, severity, owner_name/email/phone, equityPct, filingDate.
OFFMARKET_API_URL=
OFFMARKET_API_TOKEN=

# Optional seller SMS delivery via Twilio (messages still require consent_confirmed=true)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
